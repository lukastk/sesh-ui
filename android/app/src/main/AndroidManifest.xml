<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- android:largeHeap — give the app a larger Dalvik heap. Transcript view holds a lot of WebView
         DOM (Markdown bubbles, growing as you scroll history) plus the in-memory transcript cache for
         the whole mesh; the default heap makes the renderer process an easy target for OOM reclaim,
         which kills the app (see MainActivity's onRenderProcessGone recovery). This raises the ceiling
         so those kills are rarer; the recovery handler covers the ones that still happen. -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Gallery / image attach (📎 in the chat composer). Capacitor's BridgeWebChromeClient wires
         <input type=file> to the system picker (ACTION_GET_CONTENT, which needs no runtime grant);
         READ_MEDIA_IMAGES (API 33+) covers direct gallery reads. READ_EXTERNAL_STORAGE is the
         pre-33 equivalent (capped so it isn't requested on newer Android). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>
