{
  "name": "sesh-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Graphical client for sesh (desktop Svelte/Electron + Android)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "SESH_UI_DEV_URL=http://127.0.0.1:5180 electron .",
    "electron:build": "vite build && electron-builder"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "work.jackfruiting.seshui",
    "productName": "sesh-ui",
    "files": ["dist/**", "electron/**", "package.json"],
    "directories": { "output": "dist-electron" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ws": "^8.21.0"
  }
}
